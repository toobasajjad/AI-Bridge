# MongoDB Atlas (or local) connection string.
# If this is left unset, the app automatically falls back to an in-memory
# store so the demo still runs end-to-end without any DB setup.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-bridge

# Secret used to sign transactions (Phase 3). Any random string works for the demo.
SIGNING_SECRET=ai-bridge-hackathon-demo-secret
